# Copy to .env and fill in. Never commit the real .env file.

ANTHROPIC_API_KEY=

# One fine-grained GitHub PAT per configured repo, scoped to ONLY that repo
# (Contents: write, Pull requests: write, Issues: write). Env var name must
# match each repo's `github_token_env` in config.yaml.
GUPPY_TOKEN_ACME_WIDGETS=
GUPPY_TOKEN_ACME_DATA_PIPELINE=

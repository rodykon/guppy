# The scheduler: polls configured repos and dispatches jobs to ephemeral
# worker containers via a mounted Docker socket (see DESIGN.md). It does
# not itself run any agent code -- no repo checkout, no Claude Agent SDK
# calls happen in this image.

FROM python:3.11-slim

WORKDIR /app
COPY pyproject.toml ./
COPY src ./src
RUN pip install --no-cache-dir .

ENV GUPPY_CONFIG_PATH=/config/config.yaml
ENV GUPPY_DATA_VOLUME=guppy-data

ENTRYPOINT ["guppy-scheduler"]

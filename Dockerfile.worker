# Generic default worker image: one job's full pipeline run, then thrown
# away. Carries common runtimes (Node + Python) so simple repos work with
# no per-repo override. A repo needing something else should set
# `worker_image` in config.yaml to a purpose-built image instead of
# extending this one -- see DESIGN.md / config.example.yaml.
#
# Not launched via docker-compose: the scheduler starts one of these per
# job through the Docker socket. Build it once (or per repo override) so
# the image referenced in config.yaml actually exists:
#   docker build -f Dockerfile.worker -t guppy-worker:latest .

FROM python:3.11-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
        git \
        curl \
        ca-certificates \
    && curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY pyproject.toml ./
COPY src ./src
RUN pip install --no-cache-dir .

WORKDIR /work
ENTRYPOINT ["guppy-worker"]
